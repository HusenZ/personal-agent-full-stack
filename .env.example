# Copy to .env for local development: cp .env.example .env
# Every value here is a local-only placeholder. Never commit a real secret.

ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console

# Matches the Postgres service in docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+asyncpg://pia:pia@localhost:5433/pia

# At least 32 characters. Generate your own for anything beyond local use.
JWT_SECRET=local-dev-only-placeholder-not-a-real-secret

# Matches the Redis service in docker-compose.yml (host port 6380). Optional.
REDIS_URL=redis://localhost:6380/0

# Blank means unset. Required only when ENVIRONMENT=production.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2
